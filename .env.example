# --- Server ---
PORT=3000
DB_PATH=./dropship.db
# Veřejná HTTPS adresa serveru (kvůli Shopify webhooku a AliExpress OAuth callbacku)
PUBLIC_BASE_URL=https://dropship.example.cz
# Náhodný řetězec min. 24 znaků, např.: openssl rand -hex 24
ADMIN_TOKEN=
# Klíč pro šifrování tokenů e-shopů v DB (min. 32 znaků): openssl rand -hex 32
# Při ztrátě nebo změně musíš tokeny všech e-shopů zadat znovu.
SECRET_KEY=

# --- Shopify ---
# E-shopy se spravují přes POST /admin/shops (nebo v rozhraní /app).
# Volitelně: první e-shop se při startu založí z těchto proměnných.
# SHOPIFY_SHOP=nazev-obchodu.myshopify.com
# SHOPIFY_ADMIN_TOKEN=shpat_...
# SHOPIFY_WEBHOOK_SECRET=
# SHOPIFY_SHOP_NAME=Můj e-shop
# SHOPIFY_SHOP_CURRENCY=CZK
# SHOPIFY_SHOP_COUNTRY=CZ
SHOPIFY_API_VERSION=2026-10

# --- Výchozí cenové pravidlo pro nové e-shopy (každý e-shop si ho může přepsat) ---
# Kurz: kolik jednotek měny e-shopu za 1 jednotku AE_PAY_CURRENCY (Kč za 1 USD) – AKTUALIZUJ!
PRICE_FX_RATE=23
# Prodejní cena = náklad × kurz × násobek + přirážka, zaokrouhleno nahoru na krok − offset (299, 349…)
PRICE_MULTIPLIER=2.2
PRICE_FIXED_ADD=0
PRICE_ROUND_STEP=10
PRICE_ROUND_OFFSET=1
# Sklad v Shopify = min(STOCK_CAP, sklad dodavatele − STOCK_BUFFER)
STOCK_BUFFER=2
STOCK_CAP=50
PRICE_ALERT_PCT=15

# --- AliExpress Open Platform ---
AE_APP_KEY=
AE_APP_SECRET=
AE_PAY_CURRENCY=USD
# AE_ORDER_MEMO=Dropshipping order. Please do not include invoice, price or promotional material.
# AE_AUTHORIZE_URL=https://api-sg.aliexpress.com/oauth/authorize

# --- Bezpečnost objednávek ---
# true = nic se do AliExpressu neodešle, jen se zapíše, co by se stalo
DRY_RUN=true
# false = objednávky se vytvoří NEZAPLACENÉ, platíš ručně v AliExpressu
AUTO_PAY=false
# Výchozí limit jedné objednávky pro nové e-shopy (v jejich měně). Dražší čekají na schválení.
AUTO_PAY_MAX_ORDER_TOTAL=1500
# Max. automaticky placených objednávek za 24 h – GLOBÁLNĚ přes všechny e-shopy
AUTO_PAY_MAX_PER_DAY=10
ORDER_POLL_SECONDS=60

# --- Tracking ---
TRACKING_INTERVAL_MINUTES=60
TRACKING_NOTIFY_CUSTOMER=true
UNPAID_WARN_HOURS=6
TRACKING_URL_TEMPLATE=https://t.17track.net/en#nums={number}
