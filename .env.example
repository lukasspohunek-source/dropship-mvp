# --- Server ---
PORT=3000
DB_PATH=./dropship.db
# Veřejná HTTPS adresa serveru (kvůli Shopify webhooku a AliExpress OAuth callbacku)
PUBLIC_BASE_URL=https://dropship.example.cz
# Náhodný řetězec min. 24 znaků, např.: openssl rand -hex 24
ADMIN_TOKEN=
# Klíč pro šifrování tokenů e-shopů v DB (min. 32 znaků): openssl rand -hex 32
# Při ztrátě nebo změně musíš tokeny všech e-shopů zadat znovu.
SECRET_KEY=

# --- Shopify ---
# E-shopy se spravují přes POST /admin/shops (nebo v rozhraní /app).
# Volitelně: první e-shop se při startu založí z těchto proměnných.
# SHOPIFY_SHOP=nazev-obchodu.myshopify.com
# SHOPIFY_ADMIN_TOKEN=shpat_...
# SHOPIFY_WEBHOOK_SECRET=
# SHOPIFY_SHOP_NAME=Můj e-shop
# SHOPIFY_SHOP_CURRENCY=CZK
# SHOPIFY_SHOP_COUNTRY=CZ
SHOPIFY_API_VERSION=2026-10

# --- Výchozí cenové pravidlo pro nové e-shopy (každý e-shop si ho může přepsat) ---
# Kurz: kolik jednotek měny e-shopu za 1 jednotku AE_PAY_CURRENCY (Kč za 1 USD) – AKTUALIZUJ!
PRICE_FX_RATE=23
# Prodejní cena = náklad × kurz × násobek + přirážka, zaokrouhleno nahoru na krok − offset (299, 349…)
PRICE_MULTIPLIER=2.2
PRICE_FIXED_ADD=0
# Odhad dopravy z AliExpressu na kus (v AE_PAY_CURRENCY). Přičte se k nákladu i do prodejní ceny.
# Skutečná částka (zboží + doprava) se po odeslání načte z AE a v zisku má přednost.
PRICE_SHIPPING_PER_UNIT=0
PRICE_ROUND_STEP=10
PRICE_ROUND_OFFSET=1
# Sklad v Shopify = min(STOCK_CAP, sklad dodavatele − STOCK_BUFFER)
STOCK_BUFFER=2
STOCK_CAP=50
PRICE_ALERT_PCT=15

# --- AliExpress Open Platform ---
AE_APP_KEY=
AE_APP_SECRET=
AE_PAY_CURRENCY=USD
# AE_ORDER_MEMO=Dropshipping order. Please do not include invoice, price or promotional material.
# AE_AUTHORIZE_URL=https://api-sg.aliexpress.com/oauth/authorize

# --- Bezpečnost objednávek ---
# true = nic se do AliExpressu neodešle, jen se zapíše, co by se stalo
DRY_RUN=true
# false = objednávky se vytvoří NEZAPLACENÉ, platíš ručně v AliExpressu
AUTO_PAY=false
# Výchozí limit jedné objednávky pro nové e-shopy (v jejich měně). Dražší čekají na schválení.
AUTO_PAY_MAX_ORDER_TOTAL=1500
# Max. automaticky placených objednávek za 24 h – GLOBÁLNĚ přes všechny e-shopy
AUTO_PAY_MAX_PER_DAY=10
ORDER_POLL_SECONDS=60

# --- Katalog ---
# Jak často hlídat ceny a sklad (hodiny, 0 = vypnuto)
CATALOG_SYNC_HOURS=6

# --- Compliance ---
# Země sídla prodávajícího (pro rozlišení domácích a přeshraničních prodejů)
SELLER_COUNTRY=CZ
# Kurzy do EUR pro report OSS/IOSS – AKTUALIZUJ (pro přiznání se používá kurz ČNB)
OSS_FX_TO_EUR={"EUR":1,"CZK":0.04}
# GDPR retence: anonymizace zákazníků N let po poslední aktivitě (0 = vypnuto)
RETENTION_YEARS=0

# --- AI trendy (každý zdroj se zapne jen s vyplněným klíčem) ---
# Claude API – vyhodnocení kandidátů. Bez klíče se ukážou jen surové signály.
# ANTHROPIC_API_KEY=
# TRENDS_MODEL=claude-opus-5-5
# Google Trends + Google Shopping (serpapi.com)
# SERPAPI_KEY=
# Bright Data (brightdata.com) – TikTok/Instagram přes Web Scraper API, Heureka přes Web Unlocker.
# Scraping je v rozporu s podmínkami těchto platforem a může se rozbít.
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_TIKTOK_DATASET_ID=gd_...
# BRIGHTDATA_INSTAGRAM_DATASET_ID=gd_...
# BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
# Seznam našeptávač (neoficiální, bez klíče)
TRENDS_SEZNAM=true
# Názvy AE feedů (čárkou); prázdné = první dva z aliexpress.ds.feedname.get
AE_TREND_FEEDS=
# Každý běh stojí kredity API
TRENDS_MAX_RUNS_PER_DAY=10

# --- Reklamy (Meta) – jen čtení ---
# Token systémového uživatele z Business Manageru s oprávněním ads_read.
# META_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
# Poplatek platební brány: % z tržby bez DPH + pevná částka na objednávku (měna e-shopu)
ADS_FEE_PCT=2
ADS_FEE_FIXED=0
ADS_SYNC_HOURS=6
# Denní automatická analýza za posledních N dní (AI shrnutí jen s ANTHROPIC_API_KEY)
ADS_ANALYZE_DAILY=true
ADS_ANALYZE_DAYS=14
# Provádění navržených akcí po potvrzení v rozhraní (pozastavit kampaň / +20 % rozpočtu).
# Token pak potřebuje oprávnění ads_management. Výchozí: vypnuto.
ADS_ALLOW_WRITE=false

# --- Tracking ---
TRACKING_INTERVAL_MINUTES=60
TRACKING_NOTIFY_CUSTOMER=true
UNPAID_WARN_HOURS=6
TRACKING_URL_TEMPLATE=https://t.17track.net/en#nums={number}
