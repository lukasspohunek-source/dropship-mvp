# --- Server ---
PORT=3000
DB_PATH=./dropship.db
# Veřejná HTTPS adresa serveru (kvůli Shopify webhooku a AliExpress OAuth callbacku)
PUBLIC_BASE_URL=https://dropship.example.cz
# Náhodný řetězec min. 24 znaků, např.: openssl rand -hex 24
ADMIN_TOKEN=

# --- Shopify (custom app v adminu e-shopu) ---
SHOPIFY_SHOP=nazev-obchodu.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_...
# "Webhook signing secret" / API secret key aplikace
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-10

# --- AliExpress Open Platform ---
AE_APP_KEY=
AE_APP_SECRET=
AE_PAY_CURRENCY=USD
# AE_ORDER_MEMO=Dropshipping order. Please do not include invoice, price or promotional material.
# AE_AUTHORIZE_URL=https://api-sg.aliexpress.com/oauth/authorize

# --- Bezpečnost objednávek ---
# true = nic se do AliExpressu neodešle, jen se zapíše, co by se stalo
DRY_RUN=true
# false = objednávky se vytvoří NEZAPLACENÉ, platíš ručně v AliExpressu
AUTO_PAY=false
# Limit v měně e-shopu (Kč). Dražší objednávky čekají na schválení.
AUTO_PAY_MAX_ORDER_TOTAL=1500
# Max. automaticky placených objednávek za 24 h
AUTO_PAY_MAX_PER_DAY=10
ORDER_POLL_SECONDS=60

# --- Tracking ---
TRACKING_INTERVAL_MINUTES=60
TRACKING_NOTIFY_CUSTOMER=true
UNPAID_WARN_HOURS=6
TRACKING_URL_TEMPLATE=https://t.17track.net/en#nums={number}
